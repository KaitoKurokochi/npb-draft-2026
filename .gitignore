# Data — track source inputs and templates, exclude large/generated outputs
# Track: batters CSV (from NPB-scraper), position templates/manually filled files
# Exclude: nothing in data/ by default (files are small enough to track)

# Keep directory structure
!data/rosters/.gitkeep
!data/past_drafts/.gitkeep
!data/candidates/.gitkeep

# Outputs (keep directory structure, ignore content)
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep
notebooks/.ipynb_checkpoints/

